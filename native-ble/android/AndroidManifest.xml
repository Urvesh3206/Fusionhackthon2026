<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.resqgrid.emergency.ble">

    <!-- 1. Offline Bluetooth Hardware Features -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- 2. Legacy Bluetooth Permissions (Android 11 and lower) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- 3. Modern Bluetooth Permissions (Android 12+ / API 31+) -->
    <!-- Required for Doctor Peripheral: Advertising custom GATT Service -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Required for Patient Central: Scanning for Doctor Service UUID offline -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Required for both: Connecting and writing GATT Characteristics -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 4. Location Permissions (Required on Android 6–11 for BLE scanning) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 5. Background Operation & Audio Siren Alarm -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:label="ResQGrid BLE"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Background GATT Server Service for Doctor -->
        <service
            android:name=".DoctorBlePeripheralService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
