# ResQGrid AI Environment Variables Configuration
# Copy this file to .env and adjust as needed

# Mode Configuration
REPLAY=1
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=3000

# Geographic Region Defaults
DEFAULT_REGION_NAME="Puri District, Odisha, India"
DEFAULT_LAT=19.8135
DEFAULT_LON=85.8312

# External API Integrations (Optional; Deterministic snapshots used as fallback)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
GDACS_API_URL=https://www.gdacs.org/xml/rss.xml

# Security & Secrets
SECRET_KEY=resqgrid_dev_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Database Configuration (PostgreSQL/PostGIS or fallback SQLite)
DATABASE_URL=sqlite:///./resqgrid.db
